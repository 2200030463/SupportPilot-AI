# SupportPilot AI Environment Variables Example

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=supportpilot-ai-hackathon-2026-secret-key-super-secure

# OpenAI API Key for Agent Intelligence (Optional - includes local intelligent heuristic fallback)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# MongoDB Connection String (Optional - memory mode active if not provided)
MONGODB_URI=mongodb://localhost:27017/supportpilot

# App Branding & Settings
NEXT_PUBLIC_APP_NAME="SupportPilot AI"
NEXT_PUBLIC_APP_TAGLINE="AI-Powered Multilingual Customer Support Agent for Indian Businesses"
